# =============================================================================
# Federated Reserve — environment template
# Copy to .env and .env.local; never commit real secrets.
# =============================================================================

# === LLM provider (OpenRouter, NOT Anthropic SDK direct) ====================
OPENROUTER_API_KEY=sk-or-v1-PLACEHOLDER
# Phase 2 uses OpenRouter PRESETS for *infrastructure choice only* — model and
# sampling params (temperature, max_tokens). The system prompt lives in code at
# packages/agent/src/system-prompts.ts so it tracks in git. Configure presets at
# https://openrouter.ai/settings/presets — leave the system prompt blank (or
# minimal) and agent code will prepend its own.
OPENROUTER_PRESET_DEEP=state-treasurer-deep
OPENROUTER_PRESET_OBSERVER=state-treasurer-observer
# Reference for which model to bind in the preset:
#   deep:     anthropic/claude-opus-4-7
#   observer: anthropic/claude-haiku-4-5

# === Public economic data sources ===========================================
FRED_API_KEY=PLACEHOLDER_32_HEX
BLS_API_KEY=PLACEHOLDER_BLS_API_KEY
BEA_API_KEY=PLACEHOLDER_BEA_API_KEY
CENSUS_API_KEY=PLACEHOLDER_CENSUS_API_KEY

# === Onchain settlement =====================================================
UNISWAP_API_KEY=PLACEHOLDER_UNISWAP_DEV_PORTAL_KEY
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
UNICHAIN_SEPOLIA_CHAIN_ID=1301
# Block explorer base used for wallet/tx links surfaced on the dashboard.
UNICHAIN_EXPLORER_BASE_URL=https://sepolia.uniscan.xyz

# === Phase 5 — onchain reads + autonomous rebalance =========================
# Each agent batches MockUSDC + own state-token + bond balanceOf calls every
# Nth tick. Cold start always runs once before the cadence starts.
CHAIN_REFRESH_EVERY_N_TICKS=5
OG_REFRESH_EVERY_N_TICKS=10
# Set to 0 to disable autonomous rebalance swaps. When enabled, each agent
# fires a real Trading-API swap from its tick loop if the live reserve ratio
# (USDC / total notional) drifts off-target by AUTO_REBALANCE_DRIFT_BPS.
AUTO_REBALANCE_ENABLED=1
AUTO_REBALANCE_TARGET=0.20
AUTO_REBALANCE_DRIFT_BPS=500
# Min/max swap size in USDC base units (6 decimals). 50–500 USDC default.
AUTO_REBALANCE_MIN_USDC=50000000
AUTO_REBALANCE_MAX_USDC=500000000
# Don't churn — wait at least N ticks between auto-swaps.
AUTO_REBALANCE_COOLDOWN_TICKS=12

# Proactive A2A negotiation initiation. Without this the dashboard's
# Negotiations tab stays mostly empty because the executor only RESPONDS
# to inbound A2A. Each non-federal agent fires a swap proposal every
# NEGOTIATE_SWAP_EVERY_N_TICKS and a coalition invite every
# NEGOTIATE_COALITION_EVERY_N_TICKS, with a per-agent FIPS-derived offset
# so the 50-agent mesh doesn't all flood at once. Set to 0 to turn off.
INITIATE_NEGOTIATIONS_ENABLED=1
NEGOTIATE_SWAP_EVERY_N_TICKS=6
NEGOTIATE_COALITION_EVERY_N_TICKS=14
# Bond bid cadence — slower than swaps because the issuer batches bids
# over BOND_AUCTION_WINDOW_MS before evaluating, and a winning bid mints
# a real BondToken on Unichain Sepolia (small gas cost per win).
NEGOTIATE_BOND_EVERY_N_TICKS=20

# === 0G testnet (memory + iNFTs) ============================================
# 0G-Galileo-Testnet: chain id 16602, gas token "0G".
# Faucet: https://faucet.0g.ai (0.1 0G per wallet daily) — fund WALLET_DEPLOYER_ADDRESS.
# Explorers: https://chainscan-galileo.0g.ai (chain) + https://storagescan-galileo.0g.ai (storage).
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602
# Storage indexer (turbo) — required by @0gfoundation/0g-storage-ts-sdk
OG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
OG_EXPLORER_BASE_URL=https://chainscan-galileo.0g.ai
OG_STORAGE_EXPLORER_BASE_URL=https://storagescan-galileo.0g.ai
# Set to 1 to mirror agent state to 0G on each meaningful change. Requires
# minted iNFT (scripts/mint-inft.ts) + per-agent og-key.bin + funded signer.
# Off by default so fresh clones don't try to call 0G with placeholder keys.
# OG_ANCHOR_ENABLED=1

# === AXL transport ==========================================================
# Path to AXL node binary (built into vendor/axl/node)
AXL_NODE_BIN=./vendor/axl/node
# Default API and TCP ports (overridden per-node in spike configs)
AXL_API_PORT=9002
AXL_TCP_PORT=7000
AXL_ROUTER_PORT=9003
AXL_A2A_PORT=9004

# === Data plane (Phase 2) ===================================================
# Single shared sidecar service that ingests FRED (and later BLS/BEA/NOAA/GDELT)
# and serves cached state snapshots to all agents over HTTP.
DATA_PLANE_PORT=3002
DATA_PLANE_URL=http://127.0.0.1:3002
# Refresh interval for upstream re-fetch (default 1h; FRED state series tick monthly)
DATA_PLANE_REFRESH_MS=3600000
# Optional: bearer token to gate POST /refresh
# DATA_PLANE_REFRESH_TOKEN=

# === Agent runtime (Phase 2) ================================================
TICK_INTERVAL_MS=30000
# Reflection cadence: every Nth tick triggers a (possibly cached) reflection.
# At 30s ticks, N=8 → reflection every 4 minutes. Idle reflections are
# additionally skipped via input-hash check, so the LLM only fires when the
# agent has new material to summarize.
REFLECT_EVERY_N_TICKS=8
# Memory backend:
#   local  — file-backed at memory/<abbr>/ (fast, no external deps)
#   memory — in-process only (CI/tests)
#   og     — 0G Storage durable substrate with local-disk hot mirror.
#            Requires OG_RPC_URL + OG_INDEXER_RPC + a signing key
#            (OG_STORAGE_SIGNER_PK or WALLET_<AGENT>_PRIVATE_KEY or
#            WALLET_DEPLOYER_PRIVATE_KEY). When the per-agent key file at
#            memory/<abbr>/og-key.bin exists, blobs are AES-256-GCM
#            encrypted with the same key the iNFT path uses.
MEMORY_BACKEND=local
# Set to 0 to force-disable LLM calls even with a valid OPENROUTER_API_KEY
# REASONING_ENABLED=1

# === Demo wallet hierarchy ==================================================
# Derived from MASTER_SEED via BIP-44 path m/44'/60'/0'/0/{INDEX}
# Index assignments:
#   0   = Master deployer / faucet
#   100 = Federal Reserve agent
#   101 = Treasury agent
#   N   = State agent at FIPS code N (MA=25, CA=6, TX=48, NY=36, FL=12, IL=17, WA=53, AK=2, ...)
MASTER_SEED="twelve word bip39 mnemonic goes here ... ... ... ... ... ... ..."

# Master deployer (BIP-44 index 0)
WALLET_DEPLOYER_PRIVATE_KEY=0xPLACEHOLDER
WALLET_DEPLOYER_ADDRESS=0xPLACEHOLDER

# Federal Reserve (BIP-44 index 100)
WALLET_FED_PRIVATE_KEY=0xPLACEHOLDER
WALLET_FED_ADDRESS=0xPLACEHOLDER

# US Treasury (BIP-44 index 101)
WALLET_TREASURY_PRIVATE_KEY=0xPLACEHOLDER
WALLET_TREASURY_ADDRESS=0xPLACEHOLDER

# Massachusetts (BIP-44 index 25)
WALLET_MA_PRIVATE_KEY=0xPLACEHOLDER
WALLET_MA_ADDRESS=0xPLACEHOLDER

# California (BIP-44 index 6)
WALLET_CA_PRIVATE_KEY=0xPLACEHOLDER
WALLET_CA_ADDRESS=0xPLACEHOLDER

# Texas (BIP-44 index 48)
WALLET_TX_PRIVATE_KEY=0xPLACEHOLDER
WALLET_TX_ADDRESS=0xPLACEHOLDER

# New York (BIP-44 index 36)
WALLET_NY_PRIVATE_KEY=0xPLACEHOLDER
WALLET_NY_ADDRESS=0xPLACEHOLDER

# Florida (BIP-44 index 12)
WALLET_FL_PRIVATE_KEY=0xPLACEHOLDER
WALLET_FL_ADDRESS=0xPLACEHOLDER

# Illinois (BIP-44 index 17)
WALLET_IL_PRIVATE_KEY=0xPLACEHOLDER
WALLET_IL_ADDRESS=0xPLACEHOLDER

# Washington (BIP-44 index 53)
WALLET_WA_PRIVATE_KEY=0xPLACEHOLDER
WALLET_WA_ADDRESS=0xPLACEHOLDER

# Alaska (BIP-44 index 2)
WALLET_AK_PRIVATE_KEY=0xPLACEHOLDER
WALLET_AK_ADDRESS=0xPLACEHOLDER
