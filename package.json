{
  "name": "federated-reserve",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "mesh:start": "./scripts/run-local-mesh.sh",
    "mesh:stop": "./scripts/run-local-mesh.sh stop",
