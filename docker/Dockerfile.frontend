# Federated Reserve frontend — Next.js 15 dashboard.
#
# Reads from the observer's HTTP API. The observer URL is baked into the
# build via NEXT_PUBLIC_OBSERVER_HTTP_URL (Next.js compiles NEXT_PUBLIC_*
# at build time, not runtime). Default points at http://localhost:3001
# which works when both observer + frontend are docker-compose'd on the
# same host (the browser reaches both via host port-forwards).
#
# Build:
#   docker build -f docker/Dockerfile.frontend \
#     --build-arg NEXT_PUBLIC_OBSERVER_HTTP_URL=http://localhost:3001 \
#     -t federated-reserve/frontend:latest .

# -----------------------------------------------------------------------------
# Stage 1 — install workspace deps
# -----------------------------------------------------------------------------
FROM oven/bun:1.2-debian AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY tsconfig.base.json tsconfig.json ./
COPY packages/shared/package.json     packages/shared/
COPY packages/og-inft/package.json    packages/og-inft/
COPY packages/data-plane/package.json packages/data-plane/
COPY packages/agent/package.json      packages/agent/
COPY packages/observer/package.json   packages/observer/
COPY packages/frontend/package.json   packages/frontend/
RUN bun install --frozen-lockfile --ignore-scripts \
    || bun install --ignore-scripts

# -----------------------------------------------------------------------------
# Stage 2 — build Next.js
# -----------------------------------------------------------------------------
FROM oven/bun:1.2-debian AS builder
WORKDIR /app
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=deps /app/packages /app/packages
COPY tsconfig.base.json tsconfig.json /app/
COPY packages/shared   /app/packages/shared
COPY packages/og-inft  /app/packages/og-inft
COPY packages/frontend /app/packages/frontend

# NEXT_PUBLIC_* must be set at build time so it's inlined into the bundle.
ARG NEXT_PUBLIC_OBSERVER_HTTP_URL=http://localhost:3001
ENV NEXT_PUBLIC_OBSERVER_HTTP_URL=$NEXT_PUBLIC_OBSERVER_HTTP_URL

WORKDIR /app/packages/frontend
RUN bun run build

# -----------------------------------------------------------------------------
# Final image — slim runtime that runs `next start`
# -----------------------------------------------------------------------------
FROM oven/bun:1.2-debian
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/tsconfig.base.json /app/tsconfig.json /app/

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Bind to 0.0.0.0 so docker port-forwards work; the package.json `start`
# script binds to 127.0.0.1 which would never be reachable from outside.
WORKDIR /app/packages/frontend
CMD ["bunx", "next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
